# Normalise line endings: LF in repo, native checkout.
* text=auto

# Source files: LF everywhere so tooling behaves the same on all machines.
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.sln       text eol=crlf
*.json      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.css       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.sh        text eol=lf

# PowerShell scripts: CRLF is safest for Windows PowerShell.
*.ps1       text eol=crlf

# Binary files.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.docx  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
