# juvo-be configuration keys. Copy the ones you need to real environment variables or `dotnet user-secrets`.
# Never commit real values. ASP.NET Core maps "__" to ":" (ConnectionStrings__Default = ConnectionStrings:Default).

# --- Required ---
# Windows authentication example (local SQL Server / LocalDB). With SQL login add User Id=...;Password=...
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=JuvoDb;Trusted_Connection=True;TrustServerCertificate=True

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7080;http://localhost:5080

# --- Required outside Development ---
# HMAC signing key for access tokens, 32+ random characters. Never commit it.
Auth__SigningKey=
# First Super Admin (Production: leave the password empty to create no account, or set it and change it at first sign-in).
Auth__Seed__Email=admin@juvobd.local
Auth__Seed__Password=

# --- Optional (defaults shown) ---
Auth__Issuer=juvo-api
Auth__Audience=juvo-clients
Auth__AccessTokenMinutes=15
Auth__StaffRefreshTokenDays=14
Auth__CustomerRefreshTokenDays=30
Auth__RequireTwoFactorForSuperAdmin=true
Auth__FrontendBaseUrl=http://localhost:3000
Auth__PasswordMinLength=10
Auth__MaxFailedAccessAttempts=5
Auth__LockoutMinutes=15
Auth__Otp__ResendCooldownSeconds=60
Notifications__StoreOtpPlaintext=false
DataProtection__KeysPath=
Cors__AllowedOrigins__0=http://localhost:3000
Database__AutoMigrate=false
Database__CompatibilityLevel=150
Storage__RootPath=App_Data/uploads
Storage__PublicBaseUrl=/files
Outbox__Enabled=true
Outbox__PollIntervalSeconds=5
Outbox__BatchSize=20
Outbox__MaxAttempts=8
Outbox__BaseDelaySeconds=5
Outbox__MaxDelayMinutes=60
RateLimiting__Enabled=true
RateLimiting__GlobalPerMinute=300
RateLimiting__AuthPerMinute=10
RateLimiting__OtpPerMinute=5
RateLimiting__CheckoutPerMinute=20
OpenApi__Enabled=false

# --- Tests only ---
# SQL Server used by integration tests (they create and drop JuvoDb_Test_<guid> databases).
JUVO_TEST_SQL_SERVER=(localdb)\MSSQLLocalDB
# Used by `dotnet ef` design-time factory when set.
JUVO_CONNECTION=

# Demo catalog: 16 clearly marked sample products with generated pictures and stock. On in Development, off everywhere else.
# It never runs once a product without the "sample" tag exists. Set to false (or remove) when real data arrives.
Seed__SampleCatalog=false
