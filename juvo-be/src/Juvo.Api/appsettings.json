{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Database": {
    "AutoMigrate": false,
    "CompatibilityLevel": 150
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "PublicBaseUrl": "/files"
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "BaseDelaySeconds": 5,
    "MaxDelayMinutes": 60
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "OtpPerMinute": 5,
    "CheckoutPerMinute": 20
  },
  "OpenApi": {
    "Enabled": false
  },
  "Auth": {
    "Issuer": "juvo-api",
    "Audience": "juvo-clients",
    "AccessTokenMinutes": 15,
    "StaffRefreshTokenDays": 14,
    "CustomerRefreshTokenDays": 30,
    "RequireTwoFactorForSuperAdmin": true,
    "FrontendBaseUrl": "http://localhost:3000",
    "PasswordMinLength": 10,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordResetTokenMinutes": 60,
    "Otp": {
      "Length": 6,
      "ExpiryMinutes": 5,
      "ResendCooldownSeconds": 60,
      "MaxRequestsPerHourPerMobile": 5
    },
    "Seed": {
      "Email": "admin@juvobd.local",
      "UserName": "admin",
      "FullName": "Juvo Super Admin",
      "Password": ""
    }
  },
  "Notifications": {
    "Provider": "sandbox",
    "StoreOtpPlaintext": false
  },
  "DataProtection": {
    "KeysPath": ""
  }
}
