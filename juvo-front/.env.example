# Copy to .env.local for development. Nothing here is a secret; real secrets never go in this app (the browser never sees them).

# Base URL of the Juvo API (server side only; the browser talks to this app, never to the API directly).
API_BASE_URL=http://localhost:5080

# Public address of this site (used for absolute links, the manifest and social cards).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cookies are marked Secure unless this is "false". Set it to false only for plain-http local runs; keep it unset in production.
COOKIE_SECURE=false

# Mirrors the API setting Auth:RequireTwoFactorForSuperAdmin (only changes the wording of the profile page).
REQUIRE_TWO_FACTOR_FOR_SUPER_ADMIN=false

# Development gallery of every UI component at /design. It answers 404 in production unless this is "true".
ENABLE_DESIGN_PAGE=true
