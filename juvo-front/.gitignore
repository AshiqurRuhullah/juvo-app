# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
e2e/.state/
playwright-report/
test-results/

# UI check screenshots are regenerated by `npm run test:e2e:ui-checks`; only the key pages are kept as evidence.
/docs/ui-checks/*.png
!/docs/ui-checks/admin-dashboard-360.png
!/docs/ui-checks/admin-dashboard-768.png
!/docs/ui-checks/admin-dashboard-1280.png
!/docs/ui-checks/login-staff-360.png
!/docs/ui-checks/login-staff-768.png
!/docs/ui-checks/login-staff-1280.png
!/docs/ui-checks/design-system-1280.png
